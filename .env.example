# Copia este archivo como ".env" para desarrollo local si quieres probar
# con variables de entorno en vez de los valores por defecto de XAMPP.
# En Railway, estas variables las provee automáticamente el plugin de
# PostgreSQL (o defínelas tú mismo en la pestaña "Variables" del servicio).

# Railway suele exponer esta directamente al enlazar el servicio de Postgres:
DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_bd

# Alternativa si no usas DATABASE_URL (variables sueltas):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
